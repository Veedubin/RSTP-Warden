# syntax=docker/dockerfile:1.6
#
# rtsp-warden v1.2.0 — Distroless variant
#
# 4-stage build targeting Google Distroless cc-debian13:nonroot
#
# Architecture:
#   1/4 builder      — python:3.13-slim + uv → builds .venv, provides Python 3.13 runtime
#   2/4 deps         — debian:13-slim → installs ALL runtime deps (ffmpeg, opencv, zeep)
#                      Then uses ldd + a script to copy ONLY the needed .so files to /dist
#   3/4 (merged into stage 2 — single deps collector stage)
#   4/4 runtime      — gcr.io/distroless/cc-debian13:nonroot → minimal runtime
#
# Key design decisions:
#   - Uses cc-debian13 (NOT cc-debian12) because python:3.13-slim is Debian trixie (glibc 2.41)
#   - Copies /usr/local from builder (Python binary, stdlib, libpython)
#   - Uses a deps collector script to gather ONLY the .so files needed by ffmpeg + OpenCV + Python
#   - HEALTHCHECK uses Python (distroless has no curl/shell)
#   - nonroot variant: user nonroot (uid 65532)

# ===========================================================================
# Stage 1/3: builder — Python 3.13 + uv → .venv
# ===========================================================================
FROM python:3.13-slim AS builder

# Install build deps (gcc for psycopg2, libxml2/libxslt for zeep)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    libxml2-dev \
    libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Copy dependency files first (better layer caching)
COPY pyproject.toml uv.lock ./

# Install with cache mount
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

# Copy source, README (required by pyproject.toml), and install the project
COPY src ./src
COPY README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# ===========================================================================
# Stage 2/4: python-libs — collect Python's system .so deps from builder
# ===========================================================================
FROM python:3.13-slim AS python-libs

# Install the runtime system deps that Python stdlib modules need
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsqlite3-0 \
    libffi8 \
    libssl3 \
    zlib1g \
    libbz2-1.0 \
    liblzma5 \
    libreadline8 \
    libncursesw6 \
    libgdbm6 \
    libzstd1 \
    && rm -rf /var/lib/apt/lists/*

# Collect Python's system .so dependencies into /dist
RUN mkdir -p /dist/lib/x86_64-linux-gnu /dist/usr/lib/x86_64-linux-gnu /dist/etc && \
    \
    # Collect all .so dependencies of Python binary and extension modules
    for bin in /usr/local/bin/python3.13 /usr/local/lib/python3.13/lib-dynload/*.so; do \
        [ -f "$bin" ] || continue; \
        ldd "$bin" 2>/dev/null | grep '=>' | awk '{print $3}' | while read lib; do \
            if [ -f "$lib" ] && [ ! -f "/dist$lib" ]; then \
                dir=$(dirname "/dist$lib"); \
                mkdir -p "$dir" 2>/dev/null; \
                cp -L "$lib" "/dist$lib" 2>/dev/null || true; \
            fi; \
        done; \
    done && \
    \
    # Also collect .so deps from libpython itself
    for lib in /usr/local/lib/libpython3.13.so*; do \
        [ -f "$lib" ] || continue; \
        ldd "$lib" 2>/dev/null | grep '=>' | awk '{print $3}' | while read dep; do \
            if [ -f "$dep" ] && [ ! -f "/dist$dep" ]; then \
                dir=$(dirname "/dist$dep"); \
                mkdir -p "$dir" 2>/dev/null; \
                cp -L "$dep" "/dist$dep" 2>/dev/null || true; \
            fi; \
        done; \
    done && \
    \
    # Copy SSL certs
    cp -r /etc/ssl /dist/etc/ && \
    cp /etc/nsswitch.conf /dist/etc/ 2>/dev/null || true && \
    \
    echo "Python deps collected"

# ===========================================================================
# Stage 3/4: deps — install ffmpeg + OpenCV runtime deps, collect needed files
# Uses debian:13-slim to match distroless cc-debian13's glibc
# ===========================================================================
FROM debian:13-slim AS deps

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxml2 \
    libxslt1.1 \
    && rm -rf /var/lib/apt/lists/*

# Collect ONLY the files we needed into /dist using the BFS collector script.
COPY docker/collect-deps.sh /tmp/collect-deps.sh
RUN chmod +x /tmp/collect-deps.sh && /tmp/collect-deps.sh

# ===========================================================================
# Stage 4/4: runtime — distroless cc-debian13:nonroot
# ===========================================================================
FROM gcr.io/distroless/cc-debian13:nonroot AS runtime

# --- Copy Python 3.13 from builder ---
# /usr/local contains: bin/python3.13, lib/python3.13/, lib/libpython3.13.so*
COPY --from=builder /usr/local /usr/local

# --- Copy Python's system .so dependencies ---
COPY --from=python-libs /dist/lib /lib
COPY --from=python-libs /dist/usr/lib /usr/lib
COPY --from=python-libs /dist/etc /etc

# --- Copy ffmpeg + OpenCV collected system deps ---
# /dist contains: usr/bin/{ffmpeg,ffprobe}, usr/lib/... and lib/...
COPY --from=deps /dist/usr /usr
COPY --from=deps /dist/lib /lib
# Overwrite /etc/ssl from deps stage (has certs from both stages)
COPY --from=deps /dist/etc /etc

# --- Copy application from builder ---
# Apply --chown=nonroot:nonroot so the nonroot user (uid 65532) owns the
# application files. This is the only place we can chown in distroless
# (it has no chown binary).
COPY --chown=nonroot:nonroot --from=builder /app/.venv /app/.venv
COPY --chown=nonroot:nonroot --from=builder /app/src /app/src

# --- Environment ---
ENV PATH="/app/.venv/bin:/usr/local/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# The nonroot user in distroless has uid 65532
USER nonroot

WORKDIR /app

# Expose web UI port
EXPOSE 8080

# Health check — Python-based (distroless has no curl/shell)
# Note: podman silently drops HEALTHCHECK (OCI format), but Docker respects it
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["/usr/local/bin/python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=3).read()"]

# Default command
CMD ["rtsp-warden", "serve", "-c", "/app/config/config.yaml", "--web", "--web-port", "8080"]