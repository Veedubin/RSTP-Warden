[Unit]
Description=rtsp-warden — self-hosted RTSP NVR with web UI
Documentation=https://github.com/jakobcharles/rtsp-warden
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rtsp-warden
Group=rtsp-warden
WorkingDirectory=/var/lib/rtsp-warden

ExecStart=/usr/local/bin/rtsp-warden serve -c /etc/rtsp-warden/config.yaml --web --web-port 8080
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

# Logging to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rtsp-warden

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/rtsp-warden /var/log/rtsp-warden
ReadOnlyPaths=/etc/rtsp-warden

# Environment
EnvironmentFile=-/etc/rtsp-warden/warden.env
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target