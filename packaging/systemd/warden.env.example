# rtsp-warden environment overrides
# (read by systemd; uncomment to enable)

WARDEN_DB_URL=sqlite:////var/lib/rtsp-warden/data/warden.db
# WARDEN_DB_URL=postgresql+psycopg2://warden:CHANGEME@localhost:5432/warden
# Optional; otherwise a password is generated and logged on first start
# WARDEN_ADMIN_PASSWORD=admin
# WARDEN_AUTH_ENABLED=true
# Default 127.0.0.1
# WARDEN_WEB_HOST=0.0.0.0
# WARDEN_WEB_PORT=8080
# Camera credentials referenced from config.yaml as ${CAM_USER} / ${CAM_PASS}
# CAM_USER=admin
# CAM_PASS=admin
# TZ=UTC